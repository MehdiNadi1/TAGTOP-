# TAGTOP Environment Configuration
# Copy this file to .env for local development

# Supabase API (Required for live backend operations)
# Found in Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# IMPORTANT SECURITY WARNING:
# NEVER put your SUPABASE_SERVICE_ROLE_KEY in frontend code or in this file!
# The service role key bypasses Row Level Security and must only be used in trusted server environments.
