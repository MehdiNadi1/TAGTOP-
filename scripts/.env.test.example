# TAGTOP — Integration Test Credentials Template
# Copy this file to scripts/.env.test and fill in your tagtop-dev values.
# This file is committed. scripts/.env.test is gitignored and NEVER committed.
#
# Variables here use plain names (no VITE_ prefix).
# They are loaded only by scripts/test-supabase-integration.ts via Node.js.
#
# Find all values in: Supabase Dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here
